# Target application
BASE_URL=https://www.saucedemo.com

# Browser
BROWSER=chromium
HEADLESS=true
SLOW_MO=0

# Timeouts (ms)
DEFAULT_TIMEOUT=60000
NAVIGATION_TIMEOUT=30000

# Retries per Playwright Test spec (0 = off). Cucumber retries once, but only for @flaky scenarios.
RETRIES=1

# Root directory for reports, step context and screenshots
ARTIFACTS_DIR=test-results

# Demo accounts (public Sauce Labs demo shop)
STANDARD_USER=standard_user
LOCKED_OUT_USER=locked_out_user
PROBLEM_USER=problem_user
PASSWORD=secret_sauce

# Free-form environment label, printed in the run summary
TEST_ENV=demo
